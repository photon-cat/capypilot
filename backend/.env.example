# ── capypilot backend configuration ──────────────────────────────────────────
# Copy to `.env` and adjust. Docker Compose reads this file automatically.

# Postgres
POSTGRES_USER=capy
POSTGRES_PASSWORD=capy_dev_password
POSTGRES_DB=capypilot
# SQLAlchemy async DSN. Host `postgres` is the compose service name.
DATABASE_URL=postgresql+asyncpg://capy:capy_dev_password@postgres:5432/capypilot

# MinIO (S3-compatible object storage)
MINIO_ROOT_USER=capyminio
MINIO_ROOT_PASSWORD=capyminio_dev_password
S3_ENDPOINT_URL=http://minio:9000
# Endpoint the *device/browser* should be redirected to for presigned PUT/GET.
# In production this is the public URL of MinIO (behind TLS). For local dev the
# device and browser reach MinIO directly on localhost:9000.
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=capyminio
S3_SECRET_KEY=capyminio_dev_password
S3_BUCKET=capypilot-data
S3_REGION=us-east-1

# Presigned URL lifetimes (seconds)
UPLOAD_URL_TTL=3600
DOWNLOAD_URL_TTL=86400

# Auth
# Secret used to sign *user* (web UI) JWTs. Device JWTs are verified against the
# device's own registered public key, not this secret.
USER_JWT_SECRET=change_me_to_a_long_random_string
# Default local admin user created on first boot (web UI login).
ADMIN_EMAIL=admin@local
ADMIN_PASSWORD=admin

# CORS allowlist for the API (the commaai/connect web app runs on a different
# origin). "*" allows any origin; or set a comma-separated list, e.g.
# CORS_ORIGINS=https://connect.example.com,http://localhost:3000
CORS_ORIGINS=*

# Service URLs (informational; used by scripts/provision_device.py and docs)
# On a real device set these two env vars to point capypilot at this backend:
#   API_HOST=https://<your-host>
#   ATHENA_HOST=wss://<your-host>
API_HOST=http://localhost:8000
ATHENA_HOST=ws://localhost:8001

# Internal URL the API uses to reach the athena control surface (compose network).
ATHENA_INTERNAL_URL=http://athena:8001
